# PostgreSQL connection string (e.g. from Neon). If unset, DB_* variables below are used.
DATABASE_URL=postgres://user:password@host:5432/meeting_scheduler?sslmode=require

# Alternative to DATABASE_URL for local development
# DB_NAME=meeting_scheduler
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# JWT signing secret — REQUIRED in production (generate with: openssl rand -hex 32)
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# "production" enables SSL for DATABASE_URL and enforces JWT_SECRET
NODE_ENV=development

# Local server port (ignored on Vercel)
PORT=5001
